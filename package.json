{
	"name": "prepexcellence",
	"version": "1.1.5",
	"private": true,
	"description": "PrepExcellence - Complete Learning Management Platform",
	"scripts": {
		"dev": "nx run-many --target=dev --all",
		"build": "nx run-many --target=build --all",
		"test": "nx run-many --target=test --all",
		"lint": "biome check --write .",
		"lint:check": "biome check .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"prepare": "husky || true"
	},
	"packageManager": "pnpm@10.25.0",
	"devDependencies": {
		"@biomejs/biome": "2.2.4",
		"@nx/node": "^22.1.3",
		"@nx/react": "^22.1.3",
		"@nx/vite": "^22.1.3",
		"@nx/workspace": "^22.1.3",
		"@vitest/coverage-v8": "^4.0.15",
		"husky": "^9.1.7",
		"nx": "^22.1.3"
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	]
}
