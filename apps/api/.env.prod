# Environment
NODE_ENV=development
PORT=3000

ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=admin@1234

# Database
DATABASE_URL="postgresql://postgres:Admin*1234!@192.168.68.82:5432/prep-excellence?schema=public"

# Redis
REDIS_HOST=192.168.68.82
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@192.168.68.82:5672
RABBITMQ_PREFETCH=10

# Scheduler (Cron Jobs)
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=UTC

# JWT
JWT_SECRET=helloprepexcellencechangeitinproductionminimum32characters
JWT_EXPIRES_IN=3d
JWT_REFRESH_SECRET=helloprepexcellencechangeitinproductionminimum32characters
JWT_REFRESH_EXPIRES_IN=30d

# Email Configuration
# For Gmail in development
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password
EMAIL_FROM=PrepExcellence <noreply@prepexcellence.com>
EMAIL_USE_SES=false

# For AWS SES in production
# EMAIL_USE_SES=true
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-ses-access-key
# AWS_SECRET_ACCESS_KEY=your-ses-secret-key

# AWS S3 (Optional - deprecated, use MinIO instead)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET=your-bucket-name

# MinIO (S3-compatible object storage)
MINIO_ENDPOINT=cdn.trodad.com
MINIO_PORT=443
MINIO_USE_SSL=true
MINIO_ACCESS_KEY=sdhafo9q3hqd
MINIO_SECRET_KEY=salkdfjhasd987urqdwj
MINIO_BUCKET=prepexcellence
MINIO_REGION=us-east-1
STORAGE_PUBLIC_URL=https://cdn.trodad.com/prepexcellence

# Rate LimitingRATE_LIMIT_WINDOW_MS=1000
RATE_LIMIT_MAX_REQUESTS=100000000000000000

# CORS
CORS_ORIGIN=https://prepexcellence.trodad.com
VITE_BACKEND_URL=https://backend-prepexcellence.trodad.com
