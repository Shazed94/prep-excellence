				"PaymentPlan.modify",
				// Billing & Invoice
				"Billing.view",
				"Billing.add",
				"Billing.change",
				"Billing.create_invoice",
				"Billing.send_invoice",
				"Billing.view_reports",
				"Invoice.view",
				"Invoice.add",
				"Invoice.generate",
				"Invoice.send",
				// Refund management
				"Refund.view",
				"Refund.add",
				"Refund.process",
				"Refund.approve",
				// View users for billing
				"Student.view",
				"Teacher.view",
				"Instructor.view",
				"Session.view",
				"Enrollment.view",
				// Analytics & Reports
				"Analytics.view_dashboard",
				"Analytics.export",
			],

			Support: [
				// Self-management
				"User.view_own",
				"User.update_own_profile",
				"User.change_own_password",
				// View access for support
				"User.view",
				"Student.view",
				"Teacher.view",
				"Instructor.view",
				"Parent.view",
				"Course.view",
				"Module.view",
				"Lesson.view",
				"Session.view",
				"Content.view",
				"Enrollment.view",
				"Payment.view",
				"PaymentPlan.view",
				"Billing.view",
				"Invoice.view",
				// Discussion & Comment moderation
				"Discussion.view",
				"Discussion.moderate",
				"BlogComment.view",
				"BlogComment.moderate",
				// View assignments and tests
				"Assignment.view",
				"Test.view",
				"Quiz.view",
				// View progress and attendance
				"Progress.view",
				"Attendance.view",
				// Contact & Guidance
				"ContactUs.view",
				"Guidance.view",
				"FreeSeminar.view",
				"TutorRequest.view",
			],

			Affiliate: [
				// Self-management
				"User.view_own",
				"User.update_own_profile",
				"User.change_own_password",
				"Affiliate.view_own",
				"Affiliate.track_earnings",
				// Referral tracking
				"Student.view_referred",
				"Payment.view_own",
				// Analytics
				"Analytics.view_dashboard",
				"Analytics.view_own_progress",
			],

			Referral: [
				// Self-management
				"User.view_own",
				"User.update_own_profile",
				"User.change_own_password",
				"Referral.view_own",
				"Referral.track_earnings",
				// Referral tracking
				"Student.view_referred",
				"Payment.view_own",
				// Analytics
				"Analytics.view_own_progress",
			],
		};

		// 3.2️⃣ Assign permissions to roles dynamically
		for (const [roleName, permissions] of Object.entries(
			rolePermissionMappings,
		)) {
			const role = await prisma.role.findUnique({
				where: { name: roleName },
				select: { id: true },
			});

			if (!role) {
				logger.warn(
					`Role ${roleName} not found, skipping permission assignment`,
				);
				continue;
			}

			// Determine which permissions to assign
			let permissionsToAssign: string[];
			if (permissions === "ALL") {
				permissionsToAssign = createdPermissions.map((p) => p.id);
			} else {
				permissionsToAssign = permissions
					.filter((code) => permissionMap[code]) // Filter out any invalid codes
					.map((code) => permissionMap[code]);
			}

			// Assign permissions to role
			await prisma.role.update({
				where: { id: role.id },
				data: {
					permissions: {
						set: [], // Clear existing permissions first
						connect: permissionsToAssign.map((id) => ({ id })),
					},
				},
			});

			logger.info(
				`Assigned ${permissionsToAssign.length} permissions to ${roleName}`,
			);
		}

		// 4️⃣ Create SuperAdmin User and assign Role
		const superAdminRole = await prisma.role.findUnique({
			where: { name: "SuperAdmin" },
			select: { id: true },
		});

		if (!superAdminRole) throw new Error("SuperAdmin role not found");

		const adminEmail = process.env.ADMIN_EMAIL || "info@prepexcellence.com";
		const adminPassword = process.env.ADMIN_PASSWORD || "A7f!Q9mR2@Kp";
		await prisma.user.upsert({
			where: { email: adminEmail },
			update: {},
			create: {
				email: adminEmail,
				name: "Admin User",
				password: await bcrypt.hash(adminPassword, 12),
				isActive: true,
				isSuperUser: true,
				isVerified: true,
				roleId: superAdminRole.id,
			},
		});

		logger.info("Database seeding completed successfully");
	} catch (error) {
		logger.error("Error seeding database:", error);
		throw error;
	} finally {
		await prisma.$disconnect();
	}
}

main()
	.then(async () => {
		await prisma.$disconnect();
	})
	.catch(async (e) => {
		console.error(e);
		await prisma.$disconnect();
		process.exit(1);
	});
