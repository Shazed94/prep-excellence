				"Discussion.post_message",
				"Discussion.moderate",
				// Certificates
				"Certificate.view",
				"Certificate.generate",
				// Tests & Quiz
				"Test.view",
				"Test.create",
				"Test.change",
				"Test.grade",
				"Test.publish",
				"Test.view_results",
				"Quiz.view",
				"Quiz.create",
				"Quiz.change",
				"Quiz.grade",
				"Quiz.view_results",
				// Assignments & Submissions
				"Assignment.view",
				"Assignment.create",
				"Assignment.change",
				"Assignment.grade",
				"Submission.view",
				"Submission.grade",
				// Progress tracking
				"Progress.view",
				"Progress.view_enrolled",
				"Progress.track",
				// Analytics
				"Analytics.view_dashboard",
				"Analytics.view_own_progress",
			],

			Teacher: [
				// Self-management
				"User.view_own",
				"User.update_own_profile",
				"User.change_own_password",
				"Teacher.view_own",
				"TeacherProfile.view_own",
				"TeacherProfile.update_own",
				// Availability management
				"Availability.view",
