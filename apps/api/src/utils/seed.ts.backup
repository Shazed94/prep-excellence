				// Progress tracking
				"Progress.view",
				"Progress.view_enrolled",
				"Progress.track",
				// Payment (own only)
				"Payment.view_own",
				// Analytics
				"Analytics.view_dashboard",
				"Analytics.view_own_progress",
			],

			Student: [
				// Self-management
				"User.view_own",
