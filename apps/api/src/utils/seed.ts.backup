				// Review moderation
				"Review.view",
				"Review.moderate",
				"Review.approve",
				// Analytics
				"Analytics.view_dashboard",
			],

			Accountant: [
				// Self-management
				"User.view_own",
				"User.update_own_profile",
				"User.change_own_password",
				// Payment management (Phase 3)
				"Payment.view",
				"Payment.add",
				"Payment.change",
				"Payment.process",
				"Payment.refund",
				"Payment.view_reports",
				// PaymentPlan management
				"PaymentPlan.view",
