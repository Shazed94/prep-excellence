				"QuestionBank.view",
				// Progress
				"Progress.view_own",
				// Reviews
				"Review.view",
				"Review.add",
				"Review.view_own",
				// Payment & Billing
				"Payment.view_own",
				"PaymentPlan.view_own",
				"Billing.view_own",
				"Invoice.view_own",
				"Refund.view_own",
				// Blog
				"Blog.view",
				"BlogComment.view",
