// One-to-One Coaching (Teacher Booking)
// Students browse teachers, book time slots, join Jitsi sessions embedded in app
// Sessions are recorded and available for 7 days with download option

model TeacherProfile {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isActive  Boolean  @default(true)

  bio           String?
  hourlyRate    Decimal
  timezone      String  @default("UTC")
  videoUrl      String? // Intro video
  rating        Float?  @default(0)
  totalSessions Int     @default(0)
  totalReviews  Int     @default(0)

  isAvailable  Boolean @default(true)
  responseTime Int? // Average response time in hours

  teacherId String  @unique
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  specializations TeacherSpecialization[]
  availabilities  TeacherAvailability[]
  sessions        OneToOneSession[]
  reviews         OneToOneReview[]

  @@index([teacherId])
  @@index([isAvailable])
  @@map("teacher_profiles")
}

model TeacherSpecialization {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  subject     String
  level       DIFFICULTY_LEVEL @default(INTERMEDIATE)
  yearsExp    Int?
  description String?

  profileId String
  profile   TeacherProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([subject])
  @@map("teacher_specializations")
}

model TeacherAvailability {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isActive  Boolean  @default(true)

  availabilityType AVAILABILITY_TYPE

  // For RECURRING_WEEKLY
  dayOfWeek DAY_OF_WEEK?
  startTime String? // Format: "09:00" (24-hour)
  endTime   String? // Format: "17:00" (24-hour)

  // For ONE_TIME_SLOT
  specificDate      DateTime?
  specificStartTime DateTime?
  specificEndTime   DateTime?

  isBooked Boolean @default(false)

  profileId String
  profile   TeacherProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([dayOfWeek])
  @@index([specificDate])
  @@map("teacher_availabilities")
}

model OneToOneSession {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  status SESSION_STATUS @default(SCHEDULED)

  scheduledAt DateTime
  duration    Int // Duration in minutes
  timezone    String // Student's timezone for reference

  // Session details
  topic String?
  notes String? // Student's notes/requirements

  // Jitsi integration
  jitsiRoomId    String  @unique
  jitsiRoomToken String? // JWT token for security
  jitsiStartUrl  String? // Deep link for starting session

  // Session timing
  actualStartTime DateTime?
  actualEndTime   DateTime?
  actualDuration  Int? // Actual duration in minutes

  // Cancellation
  cancelledAt        DateTime?
  cancellationReason String?
  cancelledById      String?
  cancelledBy        User?     @relation("SessionCancellations", fields: [cancelledById], references: [id], onDelete: SetNull)

  teacherProfileId String
  teacherProfile   TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Restrict)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  payment   Payment?
  recording SessionRecording?
  review    OneToOneReview?

  @@index([teacherProfileId])
  @@index([studentId])
  @@index([scheduledAt])
  @@index([status])
  @@map("onetoone_sessions")
}

model SessionRecording {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Video processing (HLS streaming format via Go processor)
  status            String? // processing, ready, failed
  rawVideoUrl       String? // Original Jitsi recording path
  masterPlaylistUrl String? // HLS master.m3u8 path (sessions/123/master.m3u8)
  thumbnailUrl      String? // Thumbnail path
  fileSize          Int? // Total size in bytes (all HLS files)
  duration          Int? // Duration in seconds

  // Download support (pre-signed MinIO URLs)
  downloadUrl       String? // Temporary download link (generated on-demand)
  isDownloadEnabled Boolean   @default(true)
  downloadCount     Int       @default(0)
  lastDownloadAt    DateTime?

  // Lifecycle management (hard delete after 7 days)
  expiresAt DateTime // 7 days from createdAt
  deletedAt DateTime? // Marked when hard delete job runs

  sessionId String          @unique
  session   OneToOneSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([deletedAt])
  @@index([status])
  @@map("session_recordings")
}

model OneToOneReview {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rating   Int // 1-5
  comment  String?
  isPublic Boolean @default(true)

  // Response from teacher
  response    String?
  respondedAt DateTime?

  sessionId String          @unique
  session   OneToOneSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  teacherProfileId String
  teacherProfile   TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Restrict)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([teacherProfileId])
  @@index([studentId])
  @@map("onetoone_reviews")
}
