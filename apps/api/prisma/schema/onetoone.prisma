
model Subject {
  id    String @id @default(cuid())
  name  String @unique

  topics Topic[]

  @@map("subjects")
}


model Topic {
  id        String   @id @default(cuid())
  name      String
  subjectId String

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherSpecializations TeacherSpecialization[]

  @@index([subjectId])
  @@unique([subjectId, name])
  @@map("topics")
}



// ======= TEACHER PROFILE =======
model TeacherProfile {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isActive  Boolean  @default(true)

  bio           String?
  hourlyRate    Decimal
  timezone      String  @default("UTC")
  videoUrl      String?
  rating        Float?  @default(0)
  totalSessions Int     @default(0)
  totalReviews  Int     @default(0)
  isAvailable   Boolean @default(true)
  responseTime  Int?

  teacherId String  @unique
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  specializations TeacherSpecialization[]
  availabilities  TeacherAvailability[]
  reviews         OneToOneReview[]

  @@index([teacherId])
  @@index([isAvailable])
  @@map("teacher_profiles")
}




model TeacherSpecialization {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  yearsExp    Int?
  description String?

  profileId String
  profile   TeacherProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  topicId String
  topic   Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([topicId])
  @@unique([profileId, topicId])
  @@map("teacher_specializations")
}



model TeacherAvailability {
  id        String   @id @default(cuid())

  profileId String
  profile   TeacherProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  dayOfWeek DAY_OF_WEEK
  isActive  Boolean @default(true)

  slots     TeacherAvailabilitySlot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([profileId, dayOfWeek])
  @@index([profileId])
  @@map("teacher_availabilities")
}


model TeacherAvailabilitySlot {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  availabilityId String
  availability   TeacherAvailability @relation(fields: [availabilityId], references: [id], onDelete: Cascade)

  startTime String
  endTime   String
  isBooked  Boolean @default(false)

  // One slot -> One session
  session   OneToOneSession?

  enrollmentId String?
  enrollment   OneToOneEnrollment? @relation(fields: [enrollmentId], references: [id])

  @@index([availabilityId])
  @@index([enrollmentId])
  @@map("teacher_availability_slots")
}

model OneToOneEnrollment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  status      ENROLLMENT_STATUS @default(ACTIVE)
  enrolledAt  DateTime          @default(now())
  completedAt DateTime?

  slots  TeacherAvailabilitySlot[]

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  payments  Payment?

  @@map("one_to_one_enrollments")
}

// ======= SESSION (created from an enrollment) =======
model OneToOneSession {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  status SESSION_STATUS @default(SCHEDULED)

  scheduledAt DateTime
  duration    Int
  timezone    String

  topic   String?
  notes   String?

  jitsiRoomId    String  @unique
  jitsiRoomToken String?
  jitsiStartUrl  String?

  actualStartTime DateTime?
  actualEndTime   DateTime?
  actualDuration  Int?

  cancelledAt        DateTime?
  cancellationReason String?
  cancelledById      String?
  cancelledBy        User? @relation("SessionCancellations", fields: [cancelledById], references: [id], onDelete: SetNull)

  // One session is created from one slot
  slotId String @unique
  slot   TeacherAvailabilitySlot @relation(fields: [slotId], references: [id], onDelete: Cascade)


  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  recording SessionRecording?
  review    OneToOneReview?

  @@index([studentId])
  @@index([scheduledAt])
  @@index([status])
  @@map("onetoone_sessions")
}

// ======= SESSION RECORDING =======
model SessionRecording {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  status            String?
  rawVideoUrl       String?
  masterPlaylistUrl String?
  thumbnailUrl      String?
  fileSize          Int?
  duration          Int?

  downloadUrl       String?
  isDownloadEnabled Boolean @default(true)
  downloadCount     Int @default(0)
  lastDownloadAt    DateTime?

  expiresAt DateTime
  deletedAt DateTime?

  sessionId String  @unique
  session   OneToOneSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([deletedAt])
  @@index([status])
  @@map("session_recordings")
}

// ======= REVIEW =======
model OneToOneReview {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rating   Int
  comment  String?
  isPublic Boolean @default(true)

  response    String?
  respondedAt DateTime?

  sessionId String @unique
  session   OneToOneSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  teacherProfileId String
  teacherProfile   TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Restrict)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([teacherProfileId])
  @@index([studentId])
  @@map("one_to_one_reviews")
}
