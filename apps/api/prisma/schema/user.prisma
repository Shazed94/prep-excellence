
model User {
    id        String   @id @default(cuid())
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    isSuperUser Boolean @default(false)
    isStaff     Boolean @default(false)
    isActive    Boolean @default(true)
    isVerified  Boolean @default(false)
    lastLogin  DateTime?

    name     String
    email    String  @unique
    password String
    phone    String?
    address  String?
    image String?

    roleId String
    role   Role   @relation(fields: [roleId], references: [id],onDelete: Restrict)
    systemUser   SystemUser?
    parent       Parent?
    teacher      Teacher?
    referralUser ReferralUser?
    affiliateUser AffiliateUser?
    student      Student?
    createdById   String?
    createdBy     User?   @relation("SystemUserCreatedUsers", fields: [createdById], references: [id],onDelete: Restrict)
    createdUsers  User[]      @relation("SystemUserCreatedUsers")

    @@index([id])
    @@map("users")
}

model Role {
    id        String   @id @default(cuid())
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    isActive    Boolean @default(true)

    name        String   @unique
    description String?

    users       User[]
    permissions Permission[]
    
    @@index([id])
    @@map("roles")
}

model Permission {
    id        String   @id @default(cuid())
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    isActive    Boolean @default(true)

    codeName   String   @unique
    moduleName String
    label      String

    role       Role[]

    @@index([moduleName])
    @@map("permissions")
}




model SystemUser {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  jobTitle       JOB_TITLE?
  department     DEPARTMENT?
  qualifications String[]
  experienceYears Int?
  certifications String[]
  bio            String?


  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("system_users")
  @@index([userId])
}

model Student {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isActive  Boolean  @default(true)

  grade            String?
  class            String?
  section          String?
  rollId           Int      @unique @default(autoincrement())
  enrollmentDate   DateTime?
  currentLevel     String?
  gpa              Float?
  totalCredits     Int?
  academicStatus   ACADEMIC_STATUS     @default(ACTIVE)

  guardianName String? 
  guardianPhone String?
  guardianEmail String?


  userId               String        @unique
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parents              Parent[]      @relation("StudentParents")
  referredById         String?
  referredBy           ReferralUser? @relation(fields: [referredById], references: [id])
  referredByAffiliateId String?
  referredByAffiliate  AffiliateUser? @relation(fields: [referredByAffiliateId], references: [id])
  
  @@map("students")
}



model Parent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isActive  Boolean  @default(true)

  contactNumber  String?
  relation  RELATION_TYPE   @default(GUARDIAN)

  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  children  Student[] @relation("StudentParents")

  @@map("parents")
}




model Teacher {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isActive  Boolean  @default(true)

  qualifications String?
  experienceYears Int?
  certifications String[]
  subjects       String[]
  bio            String?

  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("teachers")
}





model ReferralUser {
  id                String   @id @default(cuid())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  isActive          Boolean  @default(true)

  earnings          Decimal  @default(0)
  bio               String?

  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  referredStudents  Student[]

  @@map("referral_users")
}


model AffiliateUser {
  id                 String   @id @default(cuid())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  isActive           Boolean  @default(true)

  companyName        String? 
  contactNumber      String?
  contactEmail       String?
  website            String?
  bio                String?
  earnings           Decimal  @default(0)


  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  referredStudents   Student[]

  @@map("affiliate_users")
}