model User {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  isSuperUser Boolean   @default(false)
  isStaff     Boolean   @default(false)
  isActive    Boolean   @default(true)
  isVerified  Boolean   @default(false)
  lastLogin   DateTime?

  name     String
  email    String  @unique
  password String
  phone    String?
  address  String?
  image    String?

  roleId        String
  role          Role           @relation(fields: [roleId], references: [id], onDelete: Restrict)
  systemUser    SystemUser?
  parent        Parent?
  teacher       Teacher?
  referralUser  ReferralUser?
  affiliateUser AffiliateUser?
  student       Student?
  createdById   String?
  createdBy     User?          @relation("SystemUserCreatedUsers", fields: [createdById], references: [id], onDelete: Restrict)
  createdUsers  User[]         @relation("SystemUserCreatedUsers")

  // Learning platform relations
  coachingCourses     CoachingCourse[]
  lmsDiscussions      LMSDiscussion[]
  coachingSubmissions CoachingSubmission[]
  refundsProcessed    Refund[]
  sessionsCancelled   OneToOneSession[]    @relation("SessionCancellations")

  @@index([id])
  @@map("users")
}

model Role {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isActive  Boolean  @default(true)

  name        String  @unique
  description String?

  users       User[]
  permissions Permission[]

  @@index([id])
  @@map("roles")
}

model Permission {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isActive  Boolean  @default(true)

  codeName   String  @unique
  moduleName String
  label      String
  scope      String? @default("all") // "all", "own", "enrolled", "children", "referred"

  role Role[]

  @@index([moduleName])
  @@map("permissions")
}

model SystemUser {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobTitle        JOB_TITLE?
  department      DEPARTMENT?
  qualifications  String[]
  experienceYears Int?
  certifications  String[]
  bio             String?

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("system_users")
}

model Student {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isActive  Boolean  @default(true)

  grade          String?
  class          String?
  section        String?
  rollId         Int             @unique @default(autoincrement())
  enrollmentDate DateTime?
  currentLevel   String?
  gpa            Float?
  totalCredits   Int?
  academicStatus ACADEMIC_STATUS @default(ACTIVE)

  guardianName  String?
  guardianPhone String?
  guardianEmail String?

  userId                String         @unique
  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  parents               Parent[]       @relation("StudentParents")
  referredById          String?
  referredBy            ReferralUser?  @relation(fields: [referredById], references: [id])
  referredByAffiliateId String?
  referredByAffiliate   AffiliateUser? @relation(fields: [referredByAffiliateId], references: [id])

  // Learning platform relations
  lmsEnrollments      LMSEnrollment[]
  lmsProgress         LMSProgress[]
  lmsQuizAttempts     LMSQuizAttempt[]
  lmsReviews          LMSReview[]
  coachingEnrollments CoachingEnrollment[]
  coachingProgress    CoachingProgress[]
  coachingSubmissions CoachingSubmission[]
  coachingAttendances CoachingAttendance[]
  coachingModuleExamAttempts CoachingModuleExamAttempt[]
  oneToOneSessions    OneToOneSession[]
  oneToOneEnrollments OneToOneEnrollment[]
  oneToOneReviews     OneToOneReview[]
  payments            Payment[]
  invoices            Invoice[]

  @@map("students")
}

model Parent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isActive  Boolean  @default(true)

  contactNumber String?
  relation      RELATION_TYPE @default(GUARDIAN)

  userId   String    @unique
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  children Student[] @relation("StudentParents")

  @@map("parents")
}

model Teacher {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isActive  Boolean  @default(true)

  qualifications  String?
  experienceYears Int?
  certifications  String[]
  subjects        String[]
  bio             String?

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Learning platform relations
  lmsCourses       LMSCourse[]
  coachingContents CoachingContent[]
  coachingModules  CoachingModule[]
  teacherProfile   TeacherProfile?

  @@map("teachers")
}

model ReferralUser {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isActive  Boolean  @default(true)

  earnings Decimal @default(0)
  bio      String?

  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  referredStudents Student[]

  @@map("referral_users")
}

model AffiliateUser {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isActive  Boolean  @default(true)

  companyName   String?
  contactNumber String?
  contactEmail  String?
  website       String?
  bio           String?
  earnings      Decimal @default(0)

  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  referredStudents Student[]

  @@map("affiliate_users")
}
