model Guidance {
  id               String   @id @default(cuid())
  firstName        String
  lastName         String?
  email            String   @unique
  phone            String
  stateRegion      String
  country          String
  studentGrade     String
  gpa              String
  takenSATACT      String
  satActScore      String
  extracurricular  String
  targetColleges   String
  questions        String
  childDescription String
  createdAt        DateTime @default(now())
}



model FreeSeminar {
  id            String        @id @default(cuid())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  parentName    String
  parentPhone   String
  parentCity    String

  studentName   String
  studentEmail  String        @unique
  studentGrade  StudentGrade
  studentSchool String
  targetScore   String
  dreamColleges String
  seminarGoals  String
  questions     String
}



model TutorRequestRegistration {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  email           String   @unique
  parentName      String
  phoneNumber     String
  address         String

  studentName     String
  studentSchool   String
  studentGrade    String
  studentPhone    String
  studentEmail    String

  needHelp        String
  studentNeed     String

  tutorType       String[]
  
  callbackTime    String
  tutoringDays    String

  referral        String?
  specificRequest String?

  fullName        String
  date            String

  agreeTerms      Boolean
}



model NewsLetter {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  email          String    @unique
}


model TrustedCompanies {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  name    String    @unique
  logo    String
}




model CollegeEssayReview {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentName  String
  parentName   String
  email        String
  phone        String
  grade        String

  studentEmail  String
  studentSchool String
  studentPhone  String?

  address        String
  collegeTarget  String
  satExamDate    String?
  targetScore    String?
  lastSatScore   String?

  referral        String?
  parentQuestion  String?
  accommodationRequest String?

  paymentDate String
  fullName    String   // signature name
  agreedToTerms Boolean

  @@map("college_essay_reviews")
}



model ContactUs {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  firstName String
  lastName  String
  email     String
  phone     String
  query     String

  @@map("contact_us")
}




model BlogCategory {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name      String   @unique
  slug      String   @unique

  blogs     Blog[]   @relation("BlogCategories")
}


model Blog {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  image       String

  title       String   @db.VarChar(200)

  description String   @db.Text

  slug        String?  @unique
  status      BlogStatus @default(DRAFT)

  tags        String[]

  publishedAt DateTime?

  categoryId  String
  category    BlogCategory @relation("BlogCategories", fields: [categoryId], references: [id])

  authorId    String
  author      User @relation(fields: [authorId], references: [id],onDelete: Cascade)

  comments    BlogComment[] @relation("BlogComments")
  @@index([status])
  @@index([publishedAt])
  @@map("blogs")
}



model BlogComment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blogId    String
  blog      Blog     @relation("BlogComments", fields: [blogId], references: [id], onDelete: Cascade)

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  content   String   @db.Text
  parentId  String?
  parent    BlogComment? @relation("CommentReplies", fields: [parentId], references: [id],onDelete: Cascade)
  replies   BlogComment[] @relation("CommentReplies")

  isPublished Boolean @default(true)
}