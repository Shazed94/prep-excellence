model TestType {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name        String
  description String?
  order       Int     @default(0)  // 👈 drag & drop order

  @@index([id])
  @@map("test_types")
}

