

model TestType {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name        String
  description String?
  order       Int     @default(0) // 👈 drag & drop order

  questionBank QuestionBank[]
  SATPractice  SATPractice[]
  subject      Subject[]

  @@index([id])
  @@map("test_types")
}

model Subject {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name        String
  description String?
  order       Int     @default(0) // 👈 drag & drop order

  questionBank QuestionBank[]
  SATPractice  SATPractice[]
  testType     TestType[]

  domain Domain[]

  @@index([id])
  @@map("subjects")
}

model Domain {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name        String
  description String?
  order       Int     @default(0)

  questionBank QuestionBank[]
  domain       Subject[]
  skill        Skill[]

  @@index([id])
  @@map("domains")
}

model Skill {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name        String
  description String?
  order       Int     @default(0)

  questionBank QuestionBank[]
  domainId     String?
  domain       Domain[]

  @@index([id])
  @@map("skills")
}

model QuestionBank {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  isActive   Boolean  @default(true)
  questionID String   @unique @default(nanoid(8))

  orderIndex Int @default(0)

  content           String  @db.Text
  answerDescription String  @db.Text
  points            Int     @default(1)
  isUsed            Boolean @default(false)

  testTypeId String
  testType   TestType @relation(fields: [testTypeId], references: [id], onDelete: Cascade)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  difficulty DifficultyENUM

  domainId String
  domain   Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  skillId String
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  optionType OptionType @default(SINGLE_CHOICE)

  // Teacher (Teacher.id) who created this question. Nullable scalar (no FK
  // relation) so admin/legacy questions can have it null. Used to scope the
  // teacher question bank to a teacher's own questions.
  createdById String?

  options Options[]

  moduleQuestionsSetOne Module[] @relation("ModuleQuestionsSetOne")
  moduleQuestionsSetTwo Module[] @relation("ModuleQuestionsSetTwo")

  studentAnswers StudentAnswer[]
  fillBlanks     FillBlank[]

  @@index([id])
  @@index([createdById])
  @@map("question_banks")
}

model Options {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderIndex Int @default(0)

  content   String  @db.Text
  isCorrect Boolean @default(false)

  questionBankId String
  questionBank   QuestionBank @relation(fields: [questionBankId], references: [id], onDelete: Cascade)

  selectedAnswers StudentAnswerOption[]

  @@index([id])
  @@map("options")
}

model FillBlank {
  id           String   @id @default(cuid())
  answer       String
  alternatives String[]

  questionBankId String
  questionBank   QuestionBank @relation(fields: [questionBankId], references: [id], onDelete: Cascade)
}

model SATPractice {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isActive  Boolean  @default(true)

  name String?

  status       SATPracticeStatus @default(DRAFT)
  practiceType SATPracticeType   @default(TEST_PRACTICE)

  difficulty DifficultyENUM? @default(EASY)

  testTypeId String?
  testType   TestType? @relation(fields: [testTypeId], references: [id], onDelete: Cascade)

  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  section         Section[]
  studentAttempts StudentSATAttempt[]

  createdById String?
  createdBy   Teacher? @relation("TeacherCreatedSATPractices", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([id])
  @@map("sat_practice_tests")
}

model Section {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isActive  Boolean  @default(true)

  name      String?
  duration  Int?
  direction String?

  orderIndex Int

  satPracticeId String
  satPractice   SATPractice @relation(fields: [satPracticeId], references: [id], onDelete: Cascade)

  modules                Module[]
  studentSectionProgress StudentSectionProgress[]

  @@index([id])
  @@map("sat_practice_sections")
}

model Module {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isActive  Boolean  @default(true)

  name       String?
  duration   Int? // in minutes
  threshold  Int? // Fixed typo: theshold -> threshold
  direction  String?
  orderIndex Int

  sectionId String
  section   Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  questionsSetOne QuestionBank[] @relation("ModuleQuestionsSetOne")
  questionsSetTwo QuestionBank[] @relation("ModuleQuestionsSetTwo")

  studentModuleProgress StudentModuleProgress[]

  @@unique([sectionId, orderIndex])
  @@map("sat_practice_modules")
}

// ==================== STUDENT ATTEMPT & SUBMISSION MODELS ====================

model StudentSATAttempt {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentId String
  student   Student @relation("StudentAttempts", fields: [studentId], references: [id], onDelete: Cascade)

  satPracticeId String
  satPractice   SATPractice @relation(fields: [satPracticeId], references: [id], onDelete: Cascade)

  status      AttemptStatus @default(NOT_STARTED)
  startedAt   DateTime?
  completedAt DateTime?
  submittedAt DateTime?

  totalScore      Int? // Calculated score
  maxScore        Int? // Maximum possible score
  percentageScore Float? // Percentage (0-100)

  // Timing
  totalTimeSpent Int? // Total time in seconds

  sectionProgress StudentSectionProgress[]
  answers         StudentAnswer[]

  @@index([studentId])
  @@index([satPracticeId])
  @@index([status])
  @@map("student_sat_attempts")
}

model StudentSectionProgress {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attemptId String
  attempt   StudentSATAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  sectionId String?
  section   Section? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  status      AttemptStatus @default(NOT_STARTED)
  startedAt   DateTime?
  completedAt DateTime?
  timeSpent   Int? // Time spent in seconds

  currentModuleId String? // Track current module for adaptive testing

  moduleProgress StudentModuleProgress[]

  @@unique([attemptId, sectionId])
  @@index([attemptId])
  @@map("student_section_progress")
}

model StudentModuleProgress {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sectionProgressId String
  sectionProgress   StudentSectionProgress @relation(fields: [sectionProgressId], references: [id], onDelete: Cascade)

  moduleId String
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  status      AttemptStatus @default(NOT_STARTED)
  startedAt   DateTime?
  completedAt DateTime?

  usedQuestionSet String? // "SET_ONE" or "SET_TWO" - which set was used
  score           Int? // Score achieved in this module
  maxScore        Int? // Maximum possible score
  correctAnswers  Int? // Number of correct answers
  totalQuestions  Int? // Total questions in module

  nextModuleId String? // For adaptive routing

  @@unique([sectionProgressId, moduleId])
  @@index([sectionProgressId])
  @@map("student_module_progress")
}

model StudentAnswer {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attemptId String
  attempt   StudentSATAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  questionId String
  question   QuestionBank @relation(fields: [questionId], references: [id], onDelete: Cascade)

  // For multiple choice - proper relation instead of String[]
  selectedOptions StudentAnswerOption[]

  // For text-based answers (FILL_IN_THE_BLANK, SHORT_ANSWER)
  textAnswer String? @db.Text

  // Auto-grading (for MCQ, True/False)
  isCorrect    Boolean?
  pointsEarned Int      @default(0)

  // Manual grading (for text answers)
  isManuallyGraded  Boolean   @default(false)
  gradedByTeacherId String?
  gradedByTeacher   Teacher?  @relation("TeacherGradedAnswers", fields: [gradedByTeacherId], references: [id], onDelete: SetNull)
  gradedAt          DateTime?
  teacherFeedback   String?   @db.Text

  // Timing
  timeSpent        Int?
  flaggedForReview Boolean @default(false)
  answerOrder      Int?

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
  @@index([isManuallyGraded])
  @@map("student_answers")
}

model StudentAnswerOption {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  studentAnswerId String
  studentAnswer   StudentAnswer @relation(fields: [studentAnswerId], references: [id], onDelete: Cascade)

  optionId String
  option   Options @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([studentAnswerId, optionId])
  @@index([studentAnswerId])
  @@index([optionId])
  @@map("student_answer_options")
}
