// ============================================================
// UNIFIED COURSE SCHEMA (COACHING + LMS)
// Single Course model with courseType = COACHING | LMS
//
// COACHING: Institution-led, scheduled classes, attendance,
//           payment-based module unlock, installments.
// LMS:      Self-paced, sequential unlock, video-focused,
//           reviews/ratings, discussions.
//
// Hierarchy: Course → Module → Lesson
// Lesson can have: LiveClass | RecordedVideo | ReadingMaterial
//                  | Attachment | Quiz | Assignment | Exam
// ============================================================



model Category {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isActive  Boolean  @default(true)

  name        String  @unique
  description String?

  courses Course[]

  @@map("categories")
}



model Course {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isActive  Boolean  @default(true)

  courseType COURSE_TYPE

  // ── Common fields ──
  title            String
  slug             String           @unique
  shortDescription String
  longDescription  String
  video            String?
  thumbnail        String?
  level            DIFFICULTY_LEVEL @default(BEGINNER)
  tags             String[]
  isPublished      Boolean          @default(false)
  publishedAt      DateTime?
  duration         Int? // LMS: total minutes; Coaching: total weeks
  price            Decimal?
  discount         Decimal?         @default(0)

  createdById String
  createdBy   Teacher @relation(fields: [createdById], references: [id], onDelete: Restrict)

  // ── Coaching-specific fields ──
  capacity   Int? // Maximum students allowed
  startDate  DateTime?
  endDate    DateTime?
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // ── LMS-specific fields ──
  requirements  String[]
  whatYouLearn  String[]
  averageRating Float?   @default(0)
  totalReviews  Int      @default(0)

  // ── Relations ──
  courseModules     CourseModule[]
  enrollments       Enrollment[]
  certificates      Certificate[]
  leaderboards      Leaderboard[]
  reviews           Review[]
  notifications     Notification[]
  pointTransactions PointTransaction[]

  // Coaching-only: scheduling
  schedules          CourseSchedule[]
  scheduleExceptions CourseScheduleException[]
  scheduledClasses   ScheduledClass[]

  // Course-level progress
  courseProgress CourseProgress[]

  // Commerce (coaching)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([slug])
  @@index([createdById])
  @@index([courseType])
  @@map("courses")
}

// ==================== SCHEDULE (Coaching-only) ====================

model CourseSchedule {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  dayOfWeek DAY_OF_WEEK
  startTime String // "09:00" — 24-hour
  endTime   String // "10:30" — 24-hour
  room      String? // Optional room / location

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, dayOfWeek, startTime])
  @@index([courseId])
  @@map("course_schedules")
}

model CourseScheduleException {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  exceptionDate  DateTime
  isCancelled    Boolean   @default(false)
  reason         String?
  rescheduleDate DateTime? // Alternative date if rescheduled

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, exceptionDate])
  @@index([courseId])
  @@map("course_schedule_exceptions")
}

model ScheduledClass {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  classDate   DateTime
  startTime   String // "09:00"
  endTime     String // "10:30"
  dayOfWeek   DAY_OF_WEEK
  orderIndex  Int // Maps 1:1 to Lesson.orderIndex
  isCancelled Boolean     @default(false)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  lesson      Lesson?      @relation("ScheduledClassLesson")
  attendances Attendance[]

  @@unique([courseId, classDate, startTime])
  @@index([courseId])
  @@index([classDate])
  @@map("scheduled_classes")
}

// ==================== COURSE MODULE ====================

model CourseModule {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isActive  Boolean  @default(true)

  title       String
  description String?
  orderIndex  Int // Sequential within course

  // Coaching-specific: payment-based unlock
  unlockAtPercent Int @default(0) // 0, 25, 50, 75, 100 (0 = always open)

  // Coaching-specific: per-module instructor
  instructorId String?
  instructor   Teacher? @relation(fields: [instructorId], references: [id], onDelete: SetNull)

  // LMS-specific: total duration of module in minutes
  duration Int?

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  lessons Lesson[]

  @@unique([courseId, orderIndex])
  @@index([courseId])
  @@index([instructorId])
  @@map("course_modules")
}

// ==================== LESSON ====================

model Lesson {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isActive  Boolean  @default(true)

  title       String
  description String?
  orderIndex  Int
  isPublished Boolean   @default(false)
  publishedAt DateTime?

  lessonType LESSON_TYPE

  courseModuleId String
  courseModule   CourseModule @relation(fields: [courseModuleId], references: [id], onDelete: Cascade)

  // ── Reading Material fields ──
  content String?

  // ── Content-type relations (at most one of each per lesson) ──
  liveClass    LiveClass?
  videoContent VideoContent?
  assignment   Assignment?
  exam         Exam?

  // Coaching-only: link to ScheduledClass (for attendance mapping)
  scheduledClassId String?         @unique
  scheduledClass   ScheduledClass? @relation("ScheduledClassLesson", fields: [scheduledClassId], references: [id], onDelete: SetNull)

  // Supporting
  lessonAttachments        LessonAttachment[]
  progress                 LessonProgress[]
  courseProgressReferences CourseProgress[]   @relation("CourseProgressLastLesson")

  @@unique([courseModuleId, orderIndex])
  @@index([courseModuleId])
  @@index([lessonType])
  @@map("lessons")
}

// ==================== LESSON ATTACHMENT ====================

model LessonAttachment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  title      String
  fileUrl    String? // Uploaded file path
  linkUrl    String? // External link
  fileType   String // pdf, image, video, document, link, etc.
  fileSize   Int? // Bytes (null for links)
  orderIndex Int     @default(0)

  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@map("lesson_attachments")
}

// ==================== LIVE CLASS ====================
model LiveClass {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relation
  lessonId String @unique
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  // Teacher (optional override from module teacher)
  instructorId String?
  instructor   Teacher? @relation(fields: [instructorId], references: [id], onDelete: SetNull)

  // Meeting
  provider MEETING_PROVIDER
  status   LIVE_CLASS_STATUS @default(DRAFT)

  meetingId   String?
  meetingCode String?
  meetingUrl  String?
  hostUrl     String?
  accessToken String?
  password    String?

  // Schedule
  scheduledStartAt DateTime?
  scheduledEndAt   DateTime?

  actualStartAt DateTime?
  actualEndAt   DateTime?

  durationMinutes Int?

  maxParticipants Int?

  // Recording
  isRecorded Boolean @default(false)

  videoContentId String?       @unique
  videoContent   VideoContent? @relation(fields: [videoContentId], references: [id], onDelete: SetNull)

  @@index([lessonId])
  @@index([instructorId])
  @@index([provider])
  @@index([status])
  @@map("live_classes")
}

// ==================== RECORDED VIDEO ====================
// Stores video metadata and variants for on-demand content
// Live class recordings are linked via LiveClassDetail.recordedVideo

model VideoContent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title             String?
  description       String?
  status            String    @default("uploading") // uploading, processing, ready, failed
  originalFileName  String?
  rawVideoUrl       String? // MinIO path to raw uploaded video
  masterPlaylistUrl String? // HLS master.m3u8 path
  thumbnailUrl      String? // Selected thumbnail
  thumbnailOptions  Json? // [{id, url, timestamp}] from Go processor
  duration          Int? // Seconds from FFprobe
  width             Int?
  height            Int?
  codec             String?
  bitrate           Int? // bps
  fps               Float?
  fileSize          Int? // Bytes
  processedAt       DateTime?
  processingError   String?

  // Relations
  lessonId  String?        @unique
  lesson    Lesson?        @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  liveClass LiveClass?
  variants  VideoVariant[]

  @@index([status])
  @@map("video_contents")
}

model VideoVariant {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  resolution String // "360p", "480p", "720p", "1080p", "4K"
  format     String // "mp4", "hls"
  bitrate    Int? // bps
  fileSize   Int? // Bytes
  fileUrl    String // Path to variant file
  width      Int?
  height     Int?
  codec      String?

  videoContentId String
  videoContent   VideoContent @relation(fields: [videoContentId], references: [id], onDelete: Cascade)

  @@index([videoContentId])
  @@map("video_variants")
}

// ==================== EXAM ====================

model Exam {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title            String
  description      String?
  passingScore     Int     @default(70)
  timeLimit        Int? // Minutes
  maxAttempts      Int? // Null = unlimited
  shuffleQuestions Boolean @default(false)
  showResults      Boolean @default(true)

  lessonId String @unique
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  questions   ExamQuestion[]
  submissions ExamSubmission[]

  @@index([lessonId])
  @@map("exams")
}

model ExamQuestion {
  id          String       @id @default(cuid())
  question    String       @db.Text
  type        QuestionType @default(MCQ_SINGLE)
  orderIndex  Int
  points      Int          @default(1)
  explanation String?      @db.Text

  examId String
  exam   Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)

  options ExamQuestionOption[]
  answers ExamAnswer[]

  @@unique([examId, orderIndex])
  @@index([examId])
  @@map("exam_questions")
}

model ExamQuestionOption {
  id         String  @id @default(cuid())
  text       String  @db.Text
  isCorrect  Boolean @default(false)
  orderIndex Int

  questionId String
  question   ExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  answers ExamAnswer[]

  @@unique([questionId, orderIndex])
  @@index([questionId])
  @@map("exam_question_options")
}

// Workflow: Draft → Submitted → Under Review → Graded → Published

model ExamSubmission {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submittedAt DateTime?
  completedAt DateTime?

  score          Int               @default(0)
  totalPoints    Int               @default(0)
  earnedPoints   Int               @default(0)
  totalQuestions Int               @default(0)
  correctAnswers Int               @default(0)
  isPassed       Boolean           @default(false)
  timeSpent      Int               @default(0) // Seconds
  status         SUBMISSION_STATUS @default(DRAFT)

  reviewedAt      DateTime?
  reviewedById    String?
  reviewedBy      Teacher?  @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  teacherFeedback String?   @db.Text

  publishedAt DateTime?

  examId String
  exam   Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  answers ExamAnswer[]

  @@index([examId])
  @@index([studentId])
  @@index([status])
  @@map("exam_submissions")
}

model ExamAnswer {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  selectedOptionId String?
  selectedOption   ExamQuestionOption? @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)

  textAnswer   String? @db.Text
  isCorrect    Boolean @default(false)
  pointsEarned Int     @default(0)

  isManuallyGraded Boolean @default(false)
  teacherScore     Int?
  teacherFeedback  String? @db.Text

  questionId String
  question   ExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  submissionId String
  submission   ExamSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, questionId])
  @@index([submissionId])
  @@index([questionId])
  @@map("exam_answers")
}

// ==================== ASSIGNMENT ====================

model Assignment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title                 String
  description           String?   @db.Text
  instructions          String?   @db.Text
  totalPoints           Int       @default(100)
  dueDate               DateTime?
  allowLateSubmission   Boolean   @default(false)
  lateSubmissionPenalty Int? // % deducted per day late

  lessonId String @unique
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  submissions AssignmentSubmission[]

  @@index([lessonId])
  @@map("assignments")
}

model AssignmentSubmission {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submittedAt DateTime?
  textAnswer  String?           @db.Text
  status      SUBMISSION_STATUS @default(DRAFT)

  score           Int?
  isPassed        Boolean?
  teacherFeedback String?   @db.Text
  reviewedAt      DateTime?
  reviewedById    String?
  reviewedBy      Teacher?  @relation(fields: [reviewedById], references: [id], onDelete: SetNull)

  publishedAt DateTime?

  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  attachments AssignmentAttachment[]

  @@unique([assignmentId, studentId])
  @@index([assignmentId])
  @@index([studentId])
  @@index([status])
  @@map("assignment_submissions")
}

model AssignmentAttachment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  title      String
  fileUrl    String
  fileType   String // pdf, image, video, document, archive, etc.
  fileSize   Int?
  orderIndex Int    @default(0)

  submissionId String
  submission   AssignmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@map("assignment_attachments")
}

// ==================== ENROLLMENT & PROGRESS ====================

model Enrollment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  status     ENROLLMENT_STATUS @default(ACTIVE)
  enrolledAt DateTime          @default(now())

  // Coaching: order reference for payment-linked enrollment
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([courseId, studentId])
  @@index([studentId])
  @@index([courseId])
  @@map("enrollments")
}

// ==================== COURSE PROGRESS ====================
// Aggregate course-level progress for a student's enrollment.
// Tracks completion, time spent, scores, and activity summary
// across all modules/lessons in the course.

model CourseProgress {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Overall progress
  progressPercent Int       @default(0) // 0-100
  startedAt       DateTime?
  completedAt     DateTime?
  isCompleted     Boolean   @default(false)

  // Time tracking (aggregated from LessonProgress)
  totalWatchTimeSeconds   Int @default(0) // Total video watch time in seconds
  totalLiveClassWatchTime Int @default(0) // Total live class watch time in seconds

  // Aggregated scores
  averageExamScore       Int @default(0)
  averageAssignmentScore Int @default(0)

  // Completion counts
  completedLessons Int @default(0)
  totalLessons     Int @default(0)
  completedModules Int @default(0)
  totalModules     Int @default(0)

  // Last activity
  lastActivityAt DateTime?
  lastLessonId   String?
  lastLesson     Lesson?   @relation("CourseProgressLastLesson", fields: [lastLessonId], references: [id], onDelete: SetNull)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  // Direct link to all LessonProgress records for this enrollment
  lessonProgresses LessonProgress[]

  @@unique([courseId, studentId])
  @@index([courseId])
  @@index([studentId])
  @@index([isCompleted])
  @@map("course_progress")
}

model LessonProgress {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  isCompleted Boolean   @default(false)
  completedAt DateTime?

  // Video tracking
  watchTimeSeconds  Int @default(0) // Seconds watched
  lastPosition      Int @default(0) // Last playback position
  completionPercent Int @default(0) // 0-100

  // Live class tracking
  liveClassWatched   Boolean @default(false)
  liveClassWatchTime Int     @default(0) // Seconds

  // Exam tracking
  examCompleted Boolean?
  examScore     Int?
  examPassed    Boolean?

  // Assignment tracking
  assignmentCompleted Boolean?
  assignmentScore     Int?
  assignmentPassed    Boolean?

  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  courseProgressId String?
  courseProgress   CourseProgress? @relation(fields: [courseProgressId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([lessonId, studentId])
  @@index([lessonId])
  @@index([studentId])
  @@index([courseProgressId])
  @@map("lesson_progress")
}

// ==================== ATTENDANCE (Coaching-only) ====================

model Attendance {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  status ATTENDANCE_STATUS @default(PRESENT)

  joinedAt   DateTime?
  leftAt     DateTime?
  duration   Int? // Minutes
  markedById String?
  markedBy   Teacher?  @relation(fields: [markedById], references: [id], onDelete: SetNull)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  scheduledClassId String
  scheduledClass   ScheduledClass @relation(fields: [scheduledClassId], references: [id], onDelete: Cascade)

  @@unique([studentId, scheduledClassId])
  @@index([scheduledClassId])
  @@index([studentId])
  @@index([status])
  @@map("attendances")
}

// ==================== REVIEW ====================

model Review {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rating  Int // 1-5
  comment String?

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([courseId, studentId])
  @@index([courseId])
  @@map("reviews")
}

// ==================== NOTIFICATION ====================

model Notification {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  type    NOTIFICATION_TYPE
  title   String
  message String            @db.Text
  isRead  Boolean           @default(false)
  readAt  DateTime?

  referenceId   String? // Target entity UUID
  referenceType String? // lesson, quiz, exam, assignment, certificate, etc.
  actionUrl     String?

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  courseId String?
  course   Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([studentId, isRead])
  @@index([studentId])
  @@index([courseId])
  @@index([type])
  @@map("notifications")
}

// ==================== CERTIFICATE ====================

model Certificate {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  certificateNumber String             @unique
  issueDate         DateTime           @default(now())
  verificationCode  String             @unique
  downloadUrl       String?
  status            CERTIFICATE_STATUS @default(ACTIVE)
  revokedAt         DateTime?
  revokedReason     String?

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([courseId, studentId])
  @@index([courseId])
  @@index([studentId])
  @@index([verificationCode])
  @@map("certificates")
}

// ==================== LEADERBOARD ====================

model Leaderboard {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  type        LEADERBOARD_TYPE @default(COURSE_WISE)
  name        String
  description String?

  courseId String?
  course   Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)

  entries LeaderboardEntry[]

  @@unique([type, courseId])
  @@index([courseId])
  @@map("leaderboards")
}

model LeaderboardEntry {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rank        Int @default(0)
  totalPoints Int @default(0)

  quizScore        Int @default(0)
  examScore        Int @default(0)
  assignmentScore  Int @default(0)
  attendancePoints Int @default(0)
  bonusPoints      Int @default(0)

  leaderboardId String
  leaderboard   Leaderboard @relation(fields: [leaderboardId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([leaderboardId, studentId])
  @@index([leaderboardId])
  @@index([studentId])
  @@map("leaderboard_entries")
}

// ==================== POINT TRANSACTION ====================

model PointTransaction {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  points      Int
  source      POINT_SOURCE
  description String?

  referenceId   String? // Polymorphic reference to source entity
  referenceType String? // quiz_submission, exam_submission, assignment_submission, attendance, etc.

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  courseId String?
  course   Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([courseId])
  @@index([source])
  @@map("point_transactions")
}
