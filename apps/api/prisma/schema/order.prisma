

model Cart {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String   @unique
  user   User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  items CartItem[]

  @@map("carts")
}




model CartItem {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  cartId String
  cart   Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  courseId String 
  course   CoachingCourse @relation(fields: [courseId], references: [id], onDelete: Restrict)

  quantity Int @default(1)

  @@unique([cartId, courseId])
  @@index([cartId])
  @@index([courseId])

  @@map("cart_items")
}


enum ORDER_STATUS {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}


model Order {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  subtotal Decimal @db.Decimal(10, 2)
  discount Decimal @default(0) @db.Decimal(10, 2)
  total    Decimal @db.Decimal(10, 2)
  status ORDER_STATUS

  items OrderItem[]

  payments Payment[]

  enrollments CoachingEnrollment[]


  @@index([userId])
  @@index([status])
  @@map("orders")
}



model OrderItem {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  orderId String
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  courseId String
  course   CoachingCourse @relation(fields: [courseId], references: [id], onDelete: Restrict)

  unitPrice Decimal @db.Decimal(10, 2)

  @@index([orderId])
  @@index([courseId])

  @@map("order_items")
}



model Payment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  amount      Decimal
  currency    String           @default("USD")
  status      PAYMENT_STATUS   @default(PENDING)
  paymentType PAYMENT_TYPE
  provider    PAYMENT_PROVIDER @default(STRIPE)

  // Payment gateway integration
  stripePaymentId String? @unique
  stripeSessionId String?
  paypalOrderId   String? @unique
  transactionId   String?

  // Payment details
  paymentMethod String? // card, bank_transfer, etc.
  last4         String? // Last 4 digits of card
  receiptUrl    String?
  metadata      Json? // Additional gateway data

  // Timing
  paidAt        DateTime?
  failedAt      DateTime?
  refundedAt    DateTime?
  failureReason String?

  orderId String
  order   Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  // Polymorphic relationships (one of these will be set)
  lmsEnrollmentId String?
  lmsEnrollment   LMSEnrollment? @relation(fields: [lmsEnrollmentId], references: [id], onDelete: Cascade)

  oneToOneSessionId String?          @unique
  oneToOneSession   OneToOneSession? @relation(fields: [oneToOneSessionId], references: [id], onDelete: Cascade)

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Restrict)

  paymentPlanId String?
  paymentPlan   PaymentPlan? @relation(fields: [paymentPlanId], references: [id], onDelete: SetNull)

  invoice Invoice?
  refunds Refund[]

  @@index([userId])
  @@index([status])
  @@index([lmsEnrollmentId])
  @@index([oneToOneSessionId])
  @@index([stripePaymentId])
  @@index([paypalOrderId])
  @@index([orderId])
  @@map("payments")
}