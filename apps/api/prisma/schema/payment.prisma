model PaymentPlan {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isActive  Boolean  @default(true)

  totalAmount     Decimal
  paidAmount      Decimal @default(0)
  remainingAmount Decimal
  currency        String  @default("USD")

  // Installment configuration (JSON array)
  // [{ amount: 250, dueDate: "2025-01-01", status: "paid", paidAt: "2024-12-25", paymentId: "pay_xxx" }, ...]
  installments Json

  // Current status
  currentInstallment Int       @default(0)
  totalInstallments  Int
  nextDueDate        DateTime?

  // Access control (percentage-based for coaching)
  unlockedPercent Int @default(0) // 0, 25, 50, 75, 100

  payments Payment[]

  @@index([nextDueDate])
  @@map("payment_plans")
}

model Invoice {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoiceNumber String    @unique
  issueDate     DateTime  @default(now())
  dueDate       DateTime?

  // Amounts
  subtotal Decimal
  tax      Decimal @default(0)
  discount Decimal @default(0)
  total    Decimal
  currency String  @default("USD")

  // Line items
  items Json // Array of invoice line items

  // Status
  isPaid Boolean   @default(false)
  paidAt DateTime?

  // PDF generation
  pdfUrl String?

  // Notes
  notes String?
  terms String?

  paymentId String  @unique
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@index([studentId])
  @@index([invoiceNumber])
  @@index([isPaid])
  @@map("invoices")
}

model Refund {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  amount   Decimal
  currency String         @default("USD")
  reason   String
  status   PAYMENT_STATUS @default(PENDING)

  // Gateway integration
  stripeRefundId String? @unique
  paypalRefundId String?

  // Processing
  processedAt   DateTime?
  processedById String?
  processedBy   User?     @relation(fields: [processedById], references: [id], onDelete: SetNull)

  // Notes
  internalNotes String?
  studentNotes  String?

  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@index([status])
  @@index([processedById])
  @@map("refunds")
}
